generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEAM_MEMBER
  FACILITY_MANAGER
  NURSE
  DOCTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VisitStatus {
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED
}

enum NotificationType {
  VISIT_BOOKED
  VISIT_REMINDER
  VISIT_CANCELLED
  VISIT_COMPLETED
  VISIT_MISSED
  MESSAGE
}

enum InContextConsentType {
  TELEHEALTH_SESSION
  CLINICAL_NOTES
}

model User {
  id             String     @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  emailLookupHash String? @unique
  /// Set by the staff member after they accept the invite — not by admin
  passwordHash   String?
  phone          String?
  avatarUrl      String?
  avatarPublicId String?
  employeeId     String?
  employeeIdLookupHash String?
  role           UserRole
  status         UserStatus @default(ACTIVE)
  invitedAt      DateTime?
  passwordSetAt  DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int        @default(0)
  specialty      String?
  medicalLicense String?
  education      String?
  yearsExperience String?
  primaryLanguage String?
  availability   String?
  isAvailable    Boolean    @default(false)
  /// Assigned only for TEAM_MEMBER. Main ADMIN has full access.
  permissions    String[]   @default([])
  facilityId     String?
  facility       Facility?  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  facilityLinks  UserFacility[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  emailOtps EmailOtp[]
  patientsCreated Patient[]
  medicationsCreated PatientMedication[]
  visitsAsProvider Visit[] @relation("VisitProvider")
  visitsBooked     Visit[] @relation("VisitBookedBy")
  visitMessages    VisitMessage[] @relation("VisitMessageSender")
  knownLoginDevices KnownLoginDevice[]
  loginActivities  LoginActivity[]
  accountSessions  AccountSession[]
  patientDeletionRequests Patient[] @relation("PatientDeletionRequests")
  inContextConsentAcknowledgments InContextConsentAcknowledgment[]

  @@index([facilityId])
  @@index([employeeIdLookupHash])
  @@map("users")
}

/// Append-only in-context consent acknowledgments (policy version, IP, user agent).
model InContextConsentAcknowledgment {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType   InContextConsentType
  policyVersion String
  ipAddress     String
  userAgent     String
  createdAt     DateTime             @default(now())

  @@unique([userId, consentType, policyVersion])
  @@index([userId, consentType])
  @@map("in_context_consent_acknowledgments")
}

model Facility {
  id            String     @id @default(uuid())
  name          String
  managerName   String
  email         String
  emailLookupHash String? @unique
  /// Set by the facility manager after they accept the invite — not by admin
  passwordHash  String?
  location      String
  phone         String
  avatarUrl      String?
  avatarPublicId String?
  status        UserStatus @default(ACTIVE)
  invitedAt     DateTime   @default(now())
  passwordSetAt DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  staff User[]
  staffLinks UserFacility[]
  patients Patient[]
  emailOtps EmailOtp[]
  knownLoginDevices KnownLoginDevice[]
  loginActivities  LoginActivity[]
  accountSessions  AccountSession[]

  @@map("facilities")
}

model UserFacility {
  userId     String
  facilityId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@id([userId, facilityId])
  @@index([facilityId])
  @@map("user_facilities")
}

enum OtpPurpose {
  PASSWORD_RESET
  LOGIN_MFA
}

model EmailOtp {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  code       String
  purpose    OtpPurpose @default(PASSWORD_RESET)
  failedAttempts Int    @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([facilityId, purpose, expiresAt])
  @@map("email_otps")
}

/// HIPAA §3.2 append-only security audit log. Application code must only INSERT.
/// DB triggers reject UPDATE/DELETE. Retain at least 6 years (see audit-retention.ts).
model SecurityAuditEvent {
  id             String   @id @default(uuid())
  eventType      String
  actorId        String
  actorRole      String
  actorEmail     String
  actorEmailLookupHash String?
  targetResource String
  ipAddress      String
  userAgent      String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([actorEmailLookupHash, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
  @@map("security_audit_events")
}

model KnownLoginDevice {
  id                String   @id @default(uuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId        String?
  facility          Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  deviceLabel       String?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @updatedAt

  @@unique([userId, deviceFingerprint])
  @@unique([facilityId, deviceFingerprint])
  @@map("known_login_devices")
}

model LoginActivity {
  id                   String    @id @default(uuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId           String?
  facility             Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  deviceFingerprint    String
  deviceLabel          String?
  ipAddress            String?
  isNewDevice          Boolean   @default(false)
  reportToken          String    @unique
  reportTokenExpiresAt DateTime
  reportedAt           DateTime?
  createdAt            DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([facilityId, createdAt])
  @@map("login_activities")
}

model AccountSession {
  id                String    @id @default(uuid())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId        String?
  facility          Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  deviceLabel       String
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  lastActiveAt      DateTime  @default(now())
  revokedAt         DateTime?

  @@index([userId, revokedAt, lastActiveAt])
  @@index([facilityId, revokedAt, lastActiveAt])
  @@map("account_sessions")
}

enum YesNoAnswer {
  yes
  no
}

enum AdlLevel {
  I
  S
  A
  T
}

enum SpecialDiet {
  regular
  calorie_controlled
  no_added_salt
  low_fat_low_cholesterol
  other
}

enum MedicationAssistance {
  self_administer
  assistance_with_self_administration
  medication_administration
}

enum ExaminerTitle {
  MD
  DO
  APRN
  PA
}

/// Residents do not log in. Admin (and later nurse/facility) create the chart.
model Patient {
  id             String @id @default(uuid())
  memberId       String @unique
  firstName      String
  lastName       String
  email          String?
  emailLookupHash String? @unique
  phone          String
  dateOfBirth    String
  avatarUrl      String
  avatarPublicId String?

  authorizedRepresentative String?
  decisionMaker            String

  nextOfKinName         String
  nextOfKinRelationship String
  nextOfKinPhone        String
  nextOfKinEmail        String
  nextOfKinAddress      String

  insuranceProvider               String
  insurancePlanName               String
  insurancePlanType               String
  insuranceMemberId               String
  insuranceGroupNumber            String
  insuranceSubscriberName         String
  insuranceSubscriberRelationship String
  insuranceEffectiveDate          String
  insurancePhone                  String

  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  status UserStatus @default(ACTIVE)

  knownAllergies               String
  medicalHistory               String
  height                       String
  weight                       String
  physicalOrSensoryLimitations String
  cognitiveOrBehavioralStatus  String
  nursingTreatmentRequirements String
  specialPrecautions           String
  elopementRisk                YesNoAnswer

  ambulation   AdlLevel
  bathing      AdlLevel
  dressing     AdlLevel
  eating       AdlLevel
  selfCare     AdlLevel
  toileting    AdlLevel
  transferring AdlLevel

  specialDiet      SpecialDiet
  specialDietOther String?

  communicableDisease  YesNoAnswer
  bedridden            YesNoAnswer
  pressureSores        YesNoAnswer
  dangerToSelfOrOthers YesNoAnswer
  require24HourCare    YesNoAnswer
  needsMetInAlf        YesNoAnswer

  currentMedications       String
  needsHelpWithMedications YesNoAnswer
  medicationAssistance     MedicationAssistance?
  additionalComments       String?

  examinerName          String
  examinerLicenseNumber String
  examinerTitle         ExaminerTitle
  examinerPhone         String
  examinerAddress       String
  examinationDate       String

  nurseNotes String @default("")
  medications PatientMedication[]
  visits      Visit[]

  /// Admin-initiated staged deletion — clinical data retained until retention window elapses.
  deletionRequestedAt       DateTime?
  deletionRequestedByUserId String?
  deletionRequestedBy       User?     @relation("PatientDeletionRequests", fields: [deletionRequestedByUserId], references: [id], onDelete: SetNull)
  anonymizedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
  @@index([createdByUserId])
  @@index([emailLookupHash])
  @@index([deletionRequestedAt])
  @@index([anonymizedAt])
  @@map("patients")
}

model PatientMedication {
  id        String @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  name         String
  dosage       String
  frequency    String
  instructions String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([createdByUserId])
  @@map("patient_medications")
}

model Visit {
  id     String      @id @default(uuid())
  reason String
  status VisitStatus @default(IN_QUEUE)

  progressNotes  String @default("")
  soapSubjective String @default("")
  soapObjective  String @default("")
  soapAssessment String @default("")
  soapPlan       String @default("")

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  providerId String
  provider   User   @relation("VisitProvider", fields: [providerId], references: [id], onDelete: Restrict)

  bookedByUserId String
  bookedBy       User   @relation("VisitBookedBy", fields: [bookedByUserId], references: [id], onDelete: Restrict)

  scheduledAt DateTime @default(now())
  reminderSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages VisitMessage[]

  @@index([patientId])
  @@index([providerId])
  @@index([bookedByUserId])
  @@index([status])
  @@index([scheduledAt, reminderSentAt])
  @@map("visits")
}

model VisitMessage {
  id      String @id @default(uuid())
  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("VisitMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  body String @default("")

  attachmentUrl      String?
  attachmentPublicId String?
  attachmentMimeType String?
  attachmentFilename String?
  attachmentBytes    Int?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([visitId, createdAt])
  @@index([senderId])
  @@map("visit_messages")
}

model Notification {
  id String @id @default(uuid())
  /// User.id or Facility.id (facility managers authenticate as the facility)
  recipientId String
  type        NotificationType
  title       String
  body        String
  href        String
  visitId     String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}
