{
  "name": "template",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "prisma generate && npx @biomejs/biome lint ./src && tsc -p tsconfig.json && tsc-alias",
    "build:docker": "tsc -p tsconfig.json && tsc-alias",
    "lint": "npx @biomejs/biome lint ./src",
    "start": "node dist/server.js",
    "encrypt:backfill": "ts-node -r tsconfig-paths/register scripts/backfill-field-encryption.ts",
    "kms:generate-dek": "ts-node -r tsconfig-paths/register scripts/generate-kms-wrapped-dek.ts",
    "retention:run": "ts-node -r tsconfig-paths/register scripts/run-retention-job.ts",
    "compliance:check-dictionary": "ts-node -r tsconfig-paths/register scripts/check-phi-data-dictionary.ts",
    "compliance:check-traceability": "ts-node -r tsconfig-paths/register scripts/check-control-traceability.ts",
    "compliance:generate-er": "ts-node -r tsconfig-paths/register scripts/generate-er-diagram.ts",
    "compliance:check": "ts-node -r tsconfig-paths/register scripts/check-compliance-docs.ts",
    "check:sensitive-logging": "ts-node -r tsconfig-paths/register scripts/check-sensitive-logging.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "provision:admin": "ts-node -r tsconfig-paths/register scripts/provision-admin.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "nodemon": "^3.1.11",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.888.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "agora-token": "^2.0.5",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "colorette": "^2.0.20",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.2.3",
    "redis": "^5.10.0",
    "resend": "^6.20.0",
    "socket.io": "^4.8.1",
    "winston": "^3.19.0",
    "zod": "^4.1.13"
  }
}
